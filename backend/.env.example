# ==========================================
# LibroVerse Backend Environment Configuration
# ==========================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_DOMAIN=http://localhost:5173

# Database (MongoDB Atlas)
MONGO_CONNECTED_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/libroverse?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Cloud Media & Document Delivery (Cloudinary)
CLOUDINARY_CLOUD=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
